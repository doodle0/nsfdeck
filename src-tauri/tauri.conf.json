{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NSFDeck",
  "version": "0.1.0",
  "identifier": "dev.nsfdeck.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NSFDeck",
        "width": 820,
        "height": 600,
        "minWidth": 560,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "NSF/NSFe chiptune player",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "nsf",
          "nsfe"
        ],
        "mimeType": "audio/x-nsf",
        "description": "NES Sound Format",
        "role": "Viewer"
      }
    ]
  }
}
